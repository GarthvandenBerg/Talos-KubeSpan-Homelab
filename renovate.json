{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":ignoreUnstable"
  ],
  "labels": ["renovate", "dependencies"],
  "timezone": "Africa/Johannesburg",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automerge": false,
  "platformAutomerge": false,

  "argocd": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Inline '# renovate:' annotations in any YAML (image tags inside Argo values, CRDs, etc.)",
      "managerFilePatterns": ["/\\.ya?ml$/"],
      "matchStrings": [
        "(?:image|tag):\\s*[\"']?(?:[^\\s:\"'#]+:)?(?<currentValue>[^\\s\"'#]+)[\"']?\\s*#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+versioning=(?<versioning>\\S+))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ],

  "packageRules": [
    {
      "description": "Do NOT update Talos - managed manually",
      "matchPackageNames": ["/talos/", "siderolabs/talos", "talosctl"],
      "enabled": false
    },
    {
      "description": "Pin PostgreSQL to 16 for CloudNative-PG",
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      "allowedVersions": "<17.0.0"
    },
    {
      "description": "Never automerge anything",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}