{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":ignoreUnstable"
  ],
  "labels": ["renovate", "dependencies"],
  "timezone": "Africa/Johannesburg",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "kustomize": {
    "fileMatch": ["(^|/)kustomization\\.ya?ml$"]
  },
  "helmv3": {
    "fileMatch": ["(^|/)kustomization\\.ya?ml$"]
  },
  "packageRules": [
    {
      "description": "Do NOT update Talos Linux or Talos Terraform providers - managed manually",
      "matchPackagePatterns": [
        "talos",
        "siderolabs/talos",
        "talosctl"
      ],
      "enabled": false
    },
    {
      "description": "Pin PostgreSQL to 16 for CloudNative-PG",
      "matchPackageNames": [
        "ghcr.io/cloudnative-pg/postgresql"
      ],
      "allowedVersions": "<17.0.0"
    },
    {
      "description": "Separate PRs for core infrastructure Helm charts",
      "matchDatasources": ["helm"],
      "groupName": null
    }
  ]
}
